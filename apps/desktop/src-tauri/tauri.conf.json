{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loadout",
  "version": "../package.json",
  "identifier": "com.jhernandezinzunza.loadout",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Loadout", "width": 1100, "height": 760, "minWidth": 860, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false },
    "deep-link": { "desktop": { "schemes": ["loadout"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
