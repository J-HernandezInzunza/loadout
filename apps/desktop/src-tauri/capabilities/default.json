{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: fs under $HOME and app data, git only, the host APIs over http, and the app's own commands (architecture.md §2.4, §5.5)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA" }, { "path": "$APPDATA/**" }],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/Library/Keychains/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.kube/**" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "git", "cmd": "git", "args": true, "sidecar": false }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "git", "cmd": "git", "args": true, "sidecar": false }
      ]
    },
    "shell:allow-kill",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://github.com/login/*" },
        { "url": "https://api.bitbucket.org/*" },
        { "url": "https://bitbucket.org/site/oauth2/*" }
      ]
    },
    "allow-real-path",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete"
  ]
}
